    postDataToAPI()
    
    while true do
        local targetTs = getNextRestockTimestamp()
        print(string.format("[GHZ] ⏳ Restock tiếp theo: %s", fmtUTC(targetTs)))
        
        -- Đợi đến timestamp đích bằng cách so sánh os.time() thực tế
        -- KHÔNG đếm ngược vì task.wait(1) bị drift
        while os.time() < targetTs do
            local remaining = targetTs - os.time()
            local mins = math.floor(remaining / 60)
            local secs = remaining % 60
            updateUI(
                string.format("Status: ⏳ Restock trong %02d:%02d", mins, secs),
                string.format("Tiếp theo: %s", fmtUTC(targetTs)),
                Color3.fromRGB(180, 180, 255)
            )
            task.wait(0.5)
            if not screenGui or not screenGui.Parent then return end
        end
        
        postDataToAPI()
    end
end)
